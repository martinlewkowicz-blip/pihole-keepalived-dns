# Example Keepalived configuration for a Pi-hole HighAvailability setup.
# Replace all placeholder values before use.

vrrp_instance PIHOLE_VIP {
    state BACKUP		# This is the node for failsafe
    interface eth0
    virtual_router_id 51
    priority 100		# The BACKUP has lower Priority
    advert_int 1

    virtual_ipaddress {
        192.168.1.100/24
    }
}
